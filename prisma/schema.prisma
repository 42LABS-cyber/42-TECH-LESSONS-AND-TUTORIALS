generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  studentNo        String             @unique
  name             String
  email            String             @unique
  phone            String?
  passwordHash     String
  role             String             @default("STUDENT")
  registrationPaid Boolean            @default(false)
  trialEndsAt      DateTime?
  createdAt        DateTime           @default(now())
  payments         Payment[]
  enrollments      Enrollment[]
  suggestions      Suggestion[]
  comments         Comment[]
  codeEntries      AccessCode[]
  reads            NotificationRead[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @db.Text
  category    String       @default("Technology")
  price       Decimal      @default(1) @db.Decimal(5, 2)
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  lessons     Lesson[]
  enrollments Enrollment[]
  payments    Payment[]
  codes       AccessCode[]
}

model Lesson {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String? @db.Text
  videoUrl    String?
  documentUrl String?
  position    Int     @default(0)
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String    @id @default(cuid())
  userId     String
  courseId   String?
  amount     Decimal   @db.Decimal(5, 2)
  purpose    String    @default("COURSE")
  reference  String?
  proofUrl   String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model AccessCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  userId    String
  courseId  String
  expiresAt DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Suggestion {
  id        String   @id @default(cuid())
  userId    String?
  message   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  message   String   @db.Text
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String             @id @default(cuid())
  title     String
  message   String             @db.Text
  createdAt DateTime           @default(now())
  reads     NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model VisitEvent {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  createdAt DateTime @default(now())
}